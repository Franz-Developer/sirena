    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "date-fns-tz": "^3.2.0",
    "hashids": "^2.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.2",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "nestjs-pino": "^4.5.0",
    "node-cache": "^5.1.2",
