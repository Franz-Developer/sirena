// C:\sirena\sirena-backend\src\modules\tablas\tablas.http
# ----------------------------------------------------------------------
# DEFINICIÓN DE VARIABLES
# ----------------------------------------------------------------------
@baseUrl = http://localhost:3010/api
@baseUrl_tablas = {{baseUrl}}/tablas
@rest-client.previewOption = body

### 1. OBTENER TOKEN DE AUTENTICACIÓN.
# @name login
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "ADMIN",
    "password": "12345678"
}

### 2. GUARDAR TOKEN EN VARIABLE.
@authToken = {{login.response.body.token}}

# ==============================================================================
# AUTENTICACIÓN - USUARIO 3
# ==============================================================================

### 1.b OBTENER TOKEN USUARIO 3
# @name loginUser3
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "GLADYS",
    "password": "12345678"
}

### 2.b GUARDAR TOKEN USUARIO 3
# @authToken = {{loginUser3.response.body.token}}

# ==============================================================================
# LISTAR TABLAS (GET)
# ==============================================================================

### LISTAR TODOS (Activos + Históricos por defecto)
GET {{baseUrl_tablas}}
Authorization: Bearer {{authToken}}

### b. LISTAR POR ESTADO ACTIVOS (1000)
GET {{baseUrl_tablas}}?estado_id=1000
Authorization: Bearer {{authToken}}

### HISTÓRICOS (1001)
GET {{baseUrl_tablas}}?estado_id=1001
Authorization: Bearer {{authToken}}

# ==============================================================================
# BÚSQUEDA POR TEXTO (q)
# ==============================================================================

### BÚSQUEDA FLEXIBLE POR NOMBRE
GET {{baseUrl_tablas}}?q=usuarios
Authorization: Bearer {{authToken}}

### Búsqueda por coincidencia exacta
GET {{baseUrl_tablas}}?q=clientes&exactMatch=1
Authorization: Bearer {{authToken}}

# ==============================================================================
# PAGINACIÓN
# ==============================================================================

### PÁGINA 1: Registros 0 al 15
GET {{baseUrl_tablas}}?offset=0&limit=16
Authorization: Bearer {{authToken}}

### Paginación con filtro de estado
GET {{baseUrl_tablas}}?estado_id=1000&offset=0&limit=5
Authorization: Bearer {{authToken}}

# ==============================================================================
# ORDENAMIENTO
# ==============================================================================

### ORDENAR POR NOMBRE (Ascendente)
GET {{baseUrl_tablas}}?sortField=nombre&sortOrder=1
Authorization: Bearer {{authToken}}

### ORDENAR POR ID (Descendente)
GET {{baseUrl_tablas}}?sortField=tabla_id&sortOrder=-1
Authorization: Bearer {{authToken}}

# ==============================================================================
# OBTENER POR ID
# ==============================================================================

### OBTENER TABLA POR ID
GET {{baseUrl_tablas}}/1
Authorization: Bearer {{authToken}}

# ==============================================================================
# CRUD TABLA
# ==============================================================================

### CREAR NUEVA TABLA
POST {{baseUrl_tablas}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "nombre": "productos"
}

### ACTUALIZAR TABLA
PATCH {{baseUrl_tablas}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "nombre": "categorias"
}

### ELIMINAR TABLA (ACTIVO → BORRADO)
DELETE {{baseUrl_tablas}}/1
Authorization: Bearer {{authToken}}

# ==============================================================================
# ARCHIVAR / DESARCHIVAR (Cambio de estado)
# ==============================================================================

### ARCHIVAR TABLA (ACTIVO → HISTÓRICO)
PATCH {{baseUrl_tablas}}/1/archivar
Authorization: Bearer {{authToken}}

### DESARCHIVAR TABLA (HISTÓRICO → ACTIVO)
PATCH {{baseUrl_tablas}}/1/desarchivar
Authorization: Bearer {{authToken}}
