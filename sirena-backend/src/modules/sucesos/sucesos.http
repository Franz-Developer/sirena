// C:\sirena\sirena-backend\src\modules\sucesos\sucesos.http
# ----------------------------------------------------------------------
# DEFINICIÓN DE VARIABLES
# ----------------------------------------------------------------------
@baseUrl = http://localhost:3010/api
@baseUrl_sucesos = {{baseUrl}}/sucesos
@rest-client.previewOption = body

### 1. OBTENER TOKEN DE AUTENTICACIÓN.
# @name login
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "ADMIN",
    "password": "12345678"
}

### 2. GUARDAR TOKEN EN VARIABLE.
@authToken = {{login.response.body.token}}

# ==============================================================================
# AUTENTICACIÓN - USUARIO 3
# ==============================================================================

### 1.b OBTENER TOKEN USUARIO 3
# @name loginUser3
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "GLADYS",
    "password": "12345678"
}

### 2.b GUARDAR TOKEN USUARIO 3
# @authToken = {{loginUser3.response.body.token}}

# ==============================================================================
# LISTAR SUCESOS (GET)
# ==============================================================================

### LISTAR TODOS (Activos + Históricos por defecto)
GET {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}

### b. LISTAR POR ESTADO ACTIVOS (1000)
GET {{baseUrl_sucesos}}?estado_id=1000
Authorization: Bearer {{authToken}}

### HISTÓRICOS (1002)
GET {{baseUrl_sucesos}}?estado_id=1002
Authorization: Bearer {{authToken}}

### LISTAR POR TABLA
GET {{baseUrl_sucesos}}?tabla_id=1
Authorization: Bearer {{authToken}}

# ==============================================================================
# BÚSQUEDA POR TEXTO (q)
# ==============================================================================

### BÚSQUEDA FLEXIBLE POR CÓDIGO, SUCESO O DESCRIPCIÓN
GET {{baseUrl_sucesos}}?q=VENTA
Authorization: Bearer {{authToken}}

### BÚSQUEDA POR CÓDIGO ESPECÍFICO
GET {{baseUrl_sucesos}}?q=DEV_CLI
Authorization: Bearer {{authToken}}

### Búsqueda por coincidencia exacta
GET {{baseUrl_sucesos}}?q=COMPRA&exactMatch=1
Authorization: Bearer {{authToken}}

# ==============================================================================
# PAGINACIÓN
# ==============================================================================

### PÁGINA 1: Registros 0 al 15
GET {{baseUrl_sucesos}}?offset=0&limit=16
Authorization: Bearer {{authToken}}

### Paginación con filtro de estado
GET {{baseUrl_sucesos}}?estado_id=1000&offset=0&limit=5
Authorization: Bearer {{authToken}}

# ==============================================================================
# ORDENAMIENTO
# ==============================================================================

### ORDENAR POR CÓDIGO (Ascendente)
GET {{baseUrl_sucesos}}?sortField=codigo&sortOrder=1
Authorization: Bearer {{authToken}}

### ORDENAR POR SUCESO (Descendente)
GET {{baseUrl_sucesos}}?sortField=suceso&sortOrder=-1
Authorization: Bearer {{authToken}}

### ORDENAR POR ID (Descendente)
GET {{baseUrl_sucesos}}?sortField=suceso_id&sortOrder=-1
Authorization: Bearer {{authToken}}

# ==============================================================================
# OBTENER POR ID
# ==============================================================================

### OBTENER SUCESO POR ID
GET {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}

### OBTENER SUCESO POR ID CON DEPENDENCIAS
GET {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}

# ==============================================================================
# CRUD SUCESO
# ==============================================================================

### CREAR NUEVO SUCESO
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "DEV_CLI",
    "suceso": "DEVOLUCION_CLIENTE",
    "descripcion": "Devolución de mercadería por parte del cliente."
}

### CREAR SUCESO CON ESTADO ESPECÍFICO
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "ANULACION",
    "suceso": "ANULACION_VENTA",
    "descripcion": "Anulación de transacción de venta.",
    "estado_id": 1000
}

### ACTUALIZAR SUCESO
PATCH {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "descripcion": "Devolución de mercadería por parte del cliente (actualizado)"
}

### ACTUALIZAR SUCESO - CAMBIAR CÓDIGO
PATCH {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "codigo": "DEV_CLIENTE"
}

### ACTUALIZAR SUCESO - CAMBIAR TABLA
PATCH {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 2
}

### ELIMINAR SUCESO (ACTIVO → BORRADO)
DELETE {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}

# ==============================================================================
# ARCHIVAR / DESARCHIVAR (Cambio de estado)
# ==============================================================================

### ARCHIVAR SUCESO (ACTIVO → HISTÓRICO)
PATCH {{baseUrl_sucesos}}/1/archivar
Authorization: Bearer {{authToken}}

### DESARCHIVAR SUCESO (HISTÓRICO → ACTIVO)
PATCH {{baseUrl_sucesos}}/1/desarchivar
Authorization: Bearer {{authToken}}

# ==============================================================================
# VALIDACIONES DE ERRORES
# ==============================================================================

### INTENTAR CREAR SUCESO CON CÓDIGO DUPLICADO
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "COMPRA",
    "suceso": "COMPRA_DUPLICADA",
    "descripcion": "Intento de crear suceso con código duplicado"
}

### INTENTAR CREAR SUCESO CON SUCESO DUPLICADO
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "COMPRA_DUP",
    "suceso": "COMPRA",
    "descripcion": "Intento de crear suceso con suceso duplicado"
}

### INTENTAR CREAR SUCESO CON CÓDIGO EN MINÚSCULAS (debe fallar)
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "compra_test",
    "suceso": "COMPRA_TEST",
    "descripcion": "Intento de crear suceso con código en minúsculas"
}

### INTENTAR CREAR SUCESO CON CÓDIGO "NINGUNO" (reservado)
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "NINGUNO",
    "suceso": "NINGUNO_TEST",
    "descripcion": "Intento de crear suceso con código reservado"
}

### INTENTAR CREAR SUCESO CON CÓDIGO Y SUCESO IGUALES
POST {{baseUrl_sucesos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "tabla_id": 1,
    "codigo": "TEST_IGUAL",
    "suceso": "TEST_IGUAL",
    "descripcion": "Intento de crear suceso con codigo y suceso iguales"
}

### INTENTAR ELIMINAR SUCESO CON DEPENDENCIAS
DELETE {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}

### INTENTAR MODIFICAR CÓDIGO DE SUCESO CON DEPENDENCIAS (usuario no admin)
PATCH {{baseUrl_sucesos}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "codigo": "CODIGO_NUEVO"
}

# ==============================================================================
# FILTROS AVANZADOS
# ==============================================================================

### FILTRAR POR TABLA Y ESTADO
GET {{baseUrl_sucesos}}?tabla_id=1&estado_id=1000
Authorization: Bearer {{authToken}}

### BÚSQUEDA CON PAGINACIÓN Y FILTROS
GET {{baseUrl_sucesos}}?q=DEV&tabla_id=1&estado_id=1000&offset=0&limit=10
Authorization: Bearer {{authToken}}

### ORDENAR POR DESCRIPCIÓN (Ascendente)
GET {{baseUrl_sucesos}}?sortField=descripcion&sortOrder=1
Authorization: Bearer {{authToken}}
